<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const colors = ['#10D98A', '#4F8EFF', '#FF8A00'];

    function createRipple(e) {
      const ripple = document.createElement('span');
      const size = 60 + Math.random() * 40;
      const color = colors[Math.floor(Math.random() * colors.length)];
      const x = e.clientX;
      const y = e.clientY;

      ripple.style.cssText = [
        'position: fixed',
        'pointer-events: none',
        'z-index: 99999',
        'width: ' + size + 'px',
        'height: ' + size + 'px',
        'left: ' + (x - size / 2) + 'px',
        'top: ' + (y - size / 2) + 'px',
        'border-radius: 50%',
        'background: ' + color,
        'opacity: 0',
        'transform: scale(0)',
        'animation: cr-ripple 700ms ease-out forwards',
      ].join(';');

      document.body.appendChild(ripple);
      setTimeout(function () { if (ripple.parentNode) ripple.parentNode.removeChild(ripple); }, 800);
    }

    document.addEventListener('click', createRipple);
    window.addEventListener('beforeunload', function () { document.removeEventListener('click', createRipple); });
  })();
</script>

<style>
  @keyframes cr-ripple {
    0% { opacity: .35; transform: scale(0); }
    60% { opacity: .25; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.6); }
  }
</style>
