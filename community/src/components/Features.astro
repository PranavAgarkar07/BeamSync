---
const features = [
  {
    id: 'feat-speed', area: 'large', tag: 'Core', tagClass: 'feat-tag-blue',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4F8EFF" stroke-width="2" stroke-linecap="square"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg>',
    title: 'High-Speed LAN Transfer',
    desc: 'Streams files directly over HTTP on your local network. Throughput limited only by your hardware — gigabit speeds achievable with zero configuration.',
    extra: 'speed-bar',
  },
  {
    id: 'feat-offline', area: 'c2', tag: 'Privacy', tagClass: 'feat-tag-green',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10D98A" stroke-width="2" stroke-linecap="square"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>',
    title: 'Fully Offline',
    desc: 'Works without any internet connection. Data never leaves your local network — ever.',
  },
  {
    id: 'feat-qr', area: 'c3', tag: 'Connect', tagClass: 'feat-tag-orange',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF8A00" stroke-width="2" stroke-linecap="square"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><line x1="14" y1="14" x2="17" y2="14" /><line x1="17" y1="14" x2="17" y2="17" /><line x1="17" y1="17" x2="20" y2="17" /><line x1="20" y1="17" x2="20" y2="20" /><line x1="14" y1="20" x2="17" y2="20" /></svg>',
    title: 'QR Code Connect',
    desc: 'Connect any mobile device instantly by scanning a QR code. No app install required on the phone.',
  },
  {
    id: 'feat-dd', area: 'c4', tag: 'UX', tagClass: 'feat-tag-blue',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4F8EFF" stroke-width="2" stroke-linecap="square"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="17 8 12 3 7 8" /><line x1="12" y1="3" x2="12" y2="15" /></svg>',
    title: 'Drag & Drop',
    desc: 'Drop files directly onto the window to begin transfer immediately. No dialogs.',
  },
  {
    id: 'feat-net', area: 'c5', tag: 'Smart', tagClass: 'feat-tag-green',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10D98A" stroke-width="2" stroke-linecap="square"><circle cx="12" cy="12" r="3" /><path d="M6.3 6.3a8 8 0 0 0 0 11.4" /><path d="M17.7 6.3a8 8 0 0 1 0 11.4" /><path d="M3 12a9 9 0 0 1 9-9" /><path d="M21 12a9 9 0 0 1-9 9" /></svg>',
    title: 'Smart Networking',
    desc: 'Auto-detects optimal local IP, finds open ports, configures Linux firewall rules automatically.',
  },
  {
    id: 'feat-audio', area: 'c6', tag: 'Audio', tagClass: 'feat-tag-red',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FF5C7A" stroke-width="2" stroke-linecap="square"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" /></svg>',
    title: 'Auditory Feedback',
    desc: 'Integrated AudioEngine provides real-time interaction sounds. Respects prefers-reduced-motion for accessibility.',
    extra: 'sound-waves',
  },
  {
    id: 'feat-token', area: 'c7', tag: 'New in v2.5.0', tagClass: 'feat-tag-green',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10D98A" stroke-width="2" stroke-linecap="square"><rect x="3" y="11" width="18" height="11" rx="1" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /><circle cx="12" cy="16.5" r="1.5" /></svg>',
    title: 'Secure Token Rotation',
    desc: 'QR credentials auto-rotate every ~4.5 min via url_changed / token_rotated events. Previous QRs revoked instantly. Active transfers defer rotation — stream stays alive.',
  },
  {
    id: 'feat-icons', area: 'c8', tag: 'New in v2.5.0', tagClass: 'feat-tag-blue',
    icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4F8EFF" stroke-width="2" stroke-linecap="square"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>',
    title: 'Rich File Intelligence',
    desc: 'Color-coded SVG icons for dozens of types — code, video, images, scripts, archives — plus intelligent staggered file lists and a live DOWNLOADED FILES lane on mobile.',
  },
];
---

<section class="features" id="features">
  <div class="wrap">
    <div class="section-header reveal">
      <span class="section-tag">Features</span>
      <h2>Built for Speed.<br>Designed for Privacy.</h2>
      <p>Every feature built on one principle — your files never leave your network.</p>
    </div>
    <div class="bento-grid">
      {features.map((f) => (
        <div class={"bento-card" + (f.id === 'feat-speed' ? ' bento-large' : '') + " reveal"} id={f.id}>
          <span class={"feat-tag " + f.tagClass}>{f.tag}</span>
          <div class="bento-icon">
            <Fragment set:html={f.icon} />
          </div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
          {f.extra === 'speed-bar' && (
            <>
              <div class="speed-bar-track">
                <div class="speed-fill"></div>
              </div>
              <div class="speed-labels">
                <span>0 MB/s</span>
                <span>~1 Gbps (LAN limit)</span>
              </div>
            </>
          )}
          {f.extra === 'sound-waves' && (
            <div class="sound-waves">
              {[0,1,2,3,4].map(i => <div class="wave"></div>)}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features { padding: 80px 28px; border-bottom: 2px solid var(--border); }
  .bento-grid {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 2px solid var(--border);
    box-shadow: var(--sh-xl);
    grid-template-areas:
      "large large c2"
      "c3 c4 c5"
      "c6 c7 c8";
  }
  .bento-card {
    background: var(--surface);
    padding: 24px 24px;
    border-right: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: var(--t);

  }
  .bento-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: transparent;
    transition: background .2s ease;
  }
  .bento-card:hover::before { background: var(--primary); }
  .bento-card:hover {
    background: var(--raised);
    transform: translate(-2px,-2px);
    box-shadow: var(--sh-md);
    z-index: 1;
    position: relative;
  }
  #feat-offline, #feat-dd, #feat-net { border-right: none; }
  #feat-token { border-right: none; }
  #feat-audio, #feat-token, #feat-icons { border-bottom: none; }
  .bento-large { grid-column: span 2; }
  .bento-icon {
    width: 48px;
    height: 48px;
    background: var(--bg);
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    box-shadow: var(--sh-sm);
  }
  .bento-card h3 { margin-bottom: 10px; color: var(--text); }
  .feat-tag {
    display: inline-block;
    font-family: var(--fm);
    font-size: .65rem;
    text-transform: uppercase;
    letter-spacing: .1em;
    padding: 2px 8px;
    margin-bottom: 10px;
    border: 1px solid;
  }
  .feat-tag-blue { border-color: var(--primary); color: var(--primary); background: rgba(79,142,255,.08); }
  .feat-tag-orange { border-color: var(--orange); color: var(--orange); background: rgba(255,138,0,.08); }
  .feat-tag-green { border-color: var(--green); color: var(--green); background: rgba(16,217,138,.08); }
  .feat-tag-red { border-color: var(--danger); color: var(--danger); background: rgba(255,92,122,.08); }

  .speed-bar-track { margin-top: 20px; height: 6px; background: var(--bg); border: 1px solid var(--border); }
  .speed-fill { height: 100%; width: 0; background: linear-gradient(90deg, var(--primary), var(--green)); transition: width 1.4s ease; }
  .bento-card.visible .speed-fill { width: 88%; }
  .speed-labels { display: flex; justify-content: space-between; margin-top: 6px; }
  .speed-labels span { font-family: var(--fm); font-size: .65rem; color: var(--muted); }
  .speed-labels span:last-child { color: var(--primary); }

  .sound-waves { display: flex; align-items: flex-end; gap: 4px; margin-top: 18px; height: 28px; }
  .wave { width: 4px; background: var(--orange); animation: wave-anim 1.1s ease-in-out infinite; }
  .wave:nth-child(1) { height: 12px; animation-delay: 0s; }
  .wave:nth-child(2) { height: 24px; animation-delay: .15s; }
  .wave:nth-child(3) { height: 18px; animation-delay: .3s; }
  .wave:nth-child(4) { height: 28px; animation-delay: .45s; }
  .wave:nth-child(5) { height: 14px; animation-delay: .6s; }
  @keyframes wave-anim { 0%,100% { transform: scaleY(1); } 50% { transform: scaleY(.3); } }

  @media (max-width: 900px) {
    .bento-grid { grid-template-columns: 1fr; grid-template-areas: unset; }
    .bento-card, .bento-large { grid-area: unset !important; grid-column: span 1; border-right: none !important; }
  }
  @media (max-width: 540px) {
    .features { padding-left: 16px; padding-right: 16px; }
    .bento-card { padding: 24px 16px; }
  }
  @media (max-width: 400px) {
    .bento-card { padding: 20px 14px; }
  }
</style>
