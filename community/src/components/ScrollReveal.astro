<script>
  (function () {
    const revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          var parent = entry.target.parentElement;
          var siblings = parent.querySelectorAll('.reveal');
          var delay = 0;
          siblings.forEach(function (el, idx) {
            if (el === entry.target) delay = idx * 80;
          });
          setTimeout(function () {
            entry.target.classList.add('visible');
          }, delay);
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    document.querySelectorAll('.reveal').forEach(function (el) { revealObserver.observe(el); });

    var sectionObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          document.querySelectorAll('.nav-links a[href^="#"]').forEach(function (a) {
            a.style.color = a.getAttribute('href') === '#' + entry.target.id ? 'var(--primary)' : '';
          });
        }
      });
    }, { threshold: 0.4 });

    document.querySelectorAll('section[id]').forEach(function (s) { sectionObserver.observe(s); });
  })();
</script>
