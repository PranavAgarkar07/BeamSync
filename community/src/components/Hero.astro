---
import DownloadBtn from './DownloadBtn.astro';
---

<section class="hero" id="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-badge reveal">
        <img src="/BeamSync/icon.png" alt="" width="16" height="16" style="object-fit:contain" />
        Open Source · MIT · P2P Offline
      </div>
      <h1 class="hero-title reveal">
        Send Files at<br />
        <em>LAN Speed.</em><br />
        <span>No Cloud. No Accounts.</span>
      </h1>
      <p class="hero-sub reveal">
        Cross-platform desktop file transfer built with Go + Svelte + Wails. Scan a QR code, drop files, done — zero cloud, zero accounts, zero internet.
      </p>
      <div class="hero-actions reveal">
        <DownloadBtn href="https://github.com/PranavAgarkar07/BeamSync/releases" size="lg" pulse>Download Free</DownloadBtn>
        <a href="https://github.com/PranavAgarkar07/BeamSync" target="_blank" rel="noopener" class="btn-secondary btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          Star on GitHub
        </a>
      </div>
    </div>
    <div class="hero-right reveal" id="hero-terminal-col">
      <div class="terminal" id="terminal-box">
        <div class="terminal-bar">
          <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
          <span class="terminal-title">bash — beamsync</span>
        </div>
        <div class="terminal-body">
          <span class="terminal-line" id="t1"></span>
          <span class="terminal-line" id="t2"></span>
          <span class="terminal-line" id="t3"></span>
          <span class="cursor" id="tcursor">▋</span>
        </div>
      </div>
      <div class="term-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
        </svg>
        Arch Linux · AUR · beamsync-bin
      </div>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100dvh; display: flex; align-items: center; padding: 0 28px; border-bottom: 2px solid var(--border); position: relative; overflow: hidden; }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(-45deg, transparent, transparent 20px, rgba(79,142,255,.03) 20px, rgba(79,142,255,.03) 22px),
      radial-gradient(circle at 30% 50%, rgba(16,217,138,.04) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    top: -200px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(16,217,138,.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-grid {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(45,63,94,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(45,63,94,.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner { max-width: 1140px; width: 100%; margin: 0 auto; display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: center; position: relative; z-index: 1; padding-top: 70px; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fm);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--green);
    border: 1px solid rgba(16,217,138,.25);
    padding: 6px 14px;
    box-shadow: 0 0 16px rgba(16,217,138,.06), var(--sh-green);
    margin-bottom: 24px;
    background: rgba(16,217,138,.06);
    backdrop-filter: blur(4px);
  }
  .hero-title { margin-bottom: 20px; }
  .hero-title em { font-style: normal; background: linear-gradient(135deg, var(--primary), #7BB3FF); color: #fff; padding: 2px 10px; display: inline-block; box-shadow: 0 2px 12px rgba(79,142,255,.25); }
  .hero-title span { display: inline-block; position: relative; color: var(--orange); }
  .hero-title span::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 5px; background: var(--orange); opacity: .6; }
  .hero-sub { font-size: 1.05rem; line-height: 1.75; margin-bottom: 28px; max-width: 520px; color: var(--muted); }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-secondary {
    font-family: var(--fd);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: var(--t);
    padding: 15px 34px;
    font-size: .95rem;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--sh-md);
  }
  .btn-secondary:hover { transform: translate(-2px,-2px); box-shadow: var(--sh-lg); background: var(--raised); }
  .btn-secondary:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .terminal { background: #060D1A; border: 2px solid var(--border); box-shadow: var(--sh-xl), 0 0 40px rgba(16,217,138,.04); position: relative; }
  .terminal::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(16,217,138,.06);
    pointer-events: none;
  }
  .terminal-bar { display: flex; align-items: center; gap: 7px; padding: 10px 16px; background: #0A1428; border-bottom: 1px solid var(--border); }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot-r { background: #FF5F57; }
  .dot-y { background: #FFBD2E; }
  .dot-g { background: #28C840; }
  .terminal-title { margin-left: auto; font-family: var(--fm); font-size: .72rem; color: var(--muted); }
  .terminal-body { padding: 20px; display: flex; flex-direction: column; gap: 8px; min-height: 110px; }
  .terminal-line { font-family: var(--fm); font-size: .83rem; display: block; }
  .terminal-line.cmd { color: var(--text); }
  .terminal-line.cmd::before { content: '$ '; color: var(--orange); }
  .terminal-line.out { color: var(--green); }
  .cursor { font-family: var(--fm); font-size: .83rem; color: var(--orange); animation: blink 1s step-end infinite; }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
  .term-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-family: var(--fm);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 5px 12px;
    background: var(--surface);
    box-shadow: var(--sh-sm);
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-right { display: block; margin-top: 40px; }
    .terminal { max-width: 100%; }
  }
  @media (max-width: 540px) {
    .hero { min-height: 100dvh; padding: 0 16px; }
    .hero-inner { padding-top: 70px; padding-bottom: 32px; }
    .hero-title { font-size: clamp(2rem, 9vw, 3rem); }
    .hero-sub { font-size: .92rem; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn-dl, .hero-actions .btn-secondary { width: 100%; justify-content: center; text-align: center; }
    .hero-badge { font-size: .65rem; padding: 4px 10px; }
  }
  @media (max-width: 400px) {
    .hero { min-height: 100dvh; padding: 0 12px; }
    .hero-inner { padding-top: 70px; padding-bottom: 30px; }
    .hero-title { font-size: clamp(1.7rem, 10vw, 2.2rem); }
    .hero-sub { font-size: .85rem; margin-bottom: 28px; }
  }
</style>

<script>
  const termBox = document.getElementById('terminal-box');
  if (termBox && window.innerWidth > 900) {
    const lines = [
      { id: 't1', cls: 'cmd', text: 'brew install beamsync' },
      { id: 't2', cls: 'out', text: ':: Resolving dependencies...' },
      { id: 't3', cls: 'out', text: '\u2713 BeamSync installed. Run: beamsync' },
    ];

    let timerId = null;
    let running = false;

    function typeText(el, text, speed) {
      return new Promise(resolve => {
        let i = 0;
        const tick = () => {
          el.textContent = text.slice(0, ++i);
          if (i < text.length) timerId = setTimeout(tick, speed);
          else resolve();
        };
        tick();
      });
    }

    async function runTerminal() {
      if (running) return;
      running = true;
      const cursor = document.getElementById('tcursor');
      for (const { id, cls, text } of lines) {
        const el = document.getElementById(id);
        if (!el) { running = false; return; }
        el.className = 'terminal-line ' + cls;
        await typeText(el, text, cls === 'cmd' ? 48 : 18);
        await new Promise(r => { timerId = setTimeout(r, 320); });
      }
      if (cursor) cursor.style.display = 'none';
      timerId = setTimeout(() => {
        lines.forEach(({ id }) => {
          const el = document.getElementById(id);
          if (el) el.textContent = '';
        });
        if (cursor) cursor.style.display = '';
        running = false;
        timerId = setTimeout(runTerminal, 4200);
      }, 4200);
    }

    const terminalObserver = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        runTerminal();
        terminalObserver.disconnect();
      }
    }, { threshold: 0.5 });
    terminalObserver.observe(termBox);

    window.addEventListener('beforeunload', () => {
      if (timerId) clearTimeout(timerId);
      terminalObserver.disconnect();
    });
  }
</script>
