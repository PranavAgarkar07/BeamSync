---
import DownloadBtn from './DownloadBtn.astro';
---

<section class="hero" id="hero">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-left">
      <a href="#whats-new" class="hero-badge reveal" style="text-decoration:none; cursor:pointer;">
        <img src="/BeamSync/icon.png" alt="" width="16" height="16" style="object-fit:contain" />
        <span class="hero-badge-dot"></span>
        v2.5.0 — New Release · Secure Rotation · Mobile Overhaul
      </a>
      <h1 class="hero-title reveal">
        Send Files at<br />
        <em>LAN Speed.</em><br />
        <span>No Cloud. No Accounts.</span>
      </h1>
      <p class="hero-sub reveal">
        Cross-platform desktop file transfer built with Go + Svelte + Wails. Scan a QR code, drop files, done — zero cloud, zero accounts, zero internet.
        <span class="hero-sub-new">✦ v2.5.0: token auto-rotation, 30-min big-file tokens &amp; revamped mobile UI — <a href="#whats-new">see what's new</a>.</span>
      </p>
      <div class="hero-actions reveal">
        <DownloadBtn href="https://github.com/PranavAgarkar07/BeamSync/releases" size="lg" pulse>Download Free</DownloadBtn>
        <a href="https://github.com/PranavAgarkar07/BeamSync" target="_blank" rel="noopener" class="btn-secondary btn-lg">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          Star on GitHub
        </a>
      </div>
    </div>
    <div class="hero-right reveal" id="hero-terminal-col">
      <div class="terminal" id="terminal-box" role="region" aria-label="BeamSync install terminal">
        <div class="terminal-bar">
          <span class="dot dot-r" aria-hidden="true"></span><span class="dot dot-y" aria-hidden="true"></span><span class="dot dot-g" aria-hidden="true"></span>
          <span class="terminal-title">bash — beamsync</span>
          <button class="term-copy" id="term-copy" type="button" aria-label="Copy install command" title="Copy">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="1"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy</span>
          </button>
        </div>
        <div class="term-tabs" role="tablist" aria-label="Install method">
          <button role="tab" aria-selected="true" data-tab="aur" class="term-tab active" type="button">AUR</button>
          <button role="tab" aria-selected="false" data-tab="binary" class="term-tab" type="button">Binary</button>
          <button role="tab" aria-selected="false" data-tab="source" class="term-tab" type="button">Source</button>
        </div>
        <div class="terminal-body" id="terminal-body" role="log" aria-live="polite" aria-atomic="false">
          <span class="terminal-line cmd" id="t1">yay -S beamsync-bin</span>
          <span class="terminal-line out" id="t2">:: Resolving dependencies...</span>
          <span class="terminal-line out success" id="t3">✓ BeamSync v2.5.0 — ready. Run: beamsync</span>
          <span class="terminal-line hint" id="t4">hint: phone needs no app — just scan QR</span>
          <span class="cursor" id="tcursor" aria-hidden="true">▋</span>
        </div>
        <div class="term-progress" aria-hidden="true"><div class="term-progress-bar" id="term-progress-bar"></div></div>
      </div>
      <div class="term-label">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
        </svg>
        Arch Linux · AUR · beamsync-bin
        <span class="term-label-ver">v2.5.0</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { min-height: 100dvh; display: flex; align-items: center; padding: 0 28px; border-bottom: 2px solid var(--border); position: relative; overflow: hidden; }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(-45deg, transparent, transparent 20px, rgba(79,142,255,.03) 20px, rgba(79,142,255,.03) 22px),
      radial-gradient(circle at 30% 50%, rgba(16,217,138,.04) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    top: -200px;
    right: -100px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(16,217,138,.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .hero-grid {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(45,63,94,.08) 1px, transparent 1px), linear-gradient(90deg, rgba(45,63,94,.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 50%, black 30%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero-inner { max-width: 1140px; width: 100%; margin: 0 auto; display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: center; position: relative; z-index: 1; padding-top: 70px; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fm);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--green);
    border: 1px solid rgba(16,217,138,.25);
    padding: 6px 14px;
    box-shadow: 0 0 16px rgba(16,217,138,.06), var(--sh-green);
    margin-bottom: 24px;
    background: rgba(16,217,138,.06);
    backdrop-filter: blur(4px);
    transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
  }
  .hero-badge:hover { transform: translate(-1px,-1px); border-color: rgba(16,217,138,.5); box-shadow: 0 0 20px rgba(16,217,138,.15), var(--sh-green); }
  .hero-badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); animation: hero-dot-pulse 1.6s ease-in-out infinite; }
  @keyframes hero-dot-pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: .7; transform: scale(.85); } }
  .hero-sub-new { display: block; margin-top: 10px; font-size: .85rem; color: var(--green); font-weight: 600; }
  .hero-sub-new a { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
  .hero-sub-new a:hover { color: var(--primary); }
  .hero-title { margin-bottom: 20px; }
  .hero-title em { font-style: normal; background: linear-gradient(135deg, var(--primary), #7BB3FF); color: #fff; padding: 2px 10px; display: inline-block; box-shadow: 0 2px 12px rgba(79,142,255,.25); }
  .hero-title span { display: inline-block; position: relative; color: var(--orange); }
  .hero-title span::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 5px; background: var(--orange); opacity: .6; }
  .hero-sub { font-size: 1.05rem; line-height: 1.75; margin-bottom: 28px; max-width: 520px; color: var(--muted); }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-secondary {
    font-family: var(--fd);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .06em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: var(--t);
    padding: 15px 34px;
    font-size: .95rem;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--sh-md);
  }
  .btn-secondary:hover { transform: translate(-2px,-2px); box-shadow: var(--sh-lg); background: var(--raised); }
  .btn-secondary:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .terminal { background: #060D1A; border: 2px solid var(--border); box-shadow: var(--sh-xl), 0 0 40px rgba(16,217,138,.04); position: relative; overflow: hidden; }
  .terminal::before {
    content: '';
    position: absolute;
    inset: -1px;
    border: 1px solid rgba(16,217,138,.06);
    pointer-events: none;
  }
  .terminal-bar { display: flex; align-items: center; gap: 7px; padding: 10px 16px; background: #0A1428; border-bottom: 1px solid var(--border); }
  .dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
  .dot-r { background: #FF5F57; }
  .dot-y { background: #FFBD2E; }
  .dot-g { background: #28C840; }
  .terminal-title { margin-right: auto; font-family: var(--fm); font-size: .72rem; color: var(--muted); }
  .term-copy {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--fm); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em;
    color: var(--muted); background: transparent; border: 1px solid var(--border); padding: 4px 8px;
    cursor: pointer; transition: color 150ms ease, border-color 150ms ease, background 150ms ease;
  }
  .term-copy:hover { color: var(--green); border-color: var(--green); background: rgba(16,217,138,.08); }
  .term-copy.copied { color: var(--green); border-color: var(--green); background: rgba(16,217,138,.12); }
  .term-copy:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .term-tabs { display: flex; gap: 0; background: #0A1428; border-bottom: 1px solid var(--border); }
  .term-tab {
    flex: 1; padding: 8px 10px; font-family: var(--fm); font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em;
    color: var(--muted); background: transparent; border: none; border-right: 1px solid var(--border);
    cursor: pointer; transition: background 150ms ease, color 150ms ease;
  }
  .term-tab:last-child { border-right: none; }
  .term-tab:hover { background: rgba(255,255,255,.04); color: var(--text); }
  .term-tab.active { background: var(--green); color: #000; }
  .term-tab:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
  .terminal-body { padding: 18px 20px; display: flex; flex-direction: column; gap: 7px; min-height: 132px; }
  .terminal-line { font-family: var(--fm); font-size: .83rem; display: block; line-height: 1.5; min-height: 1.25em; word-break: break-all; }
  .terminal-line.cmd { color: var(--text); }
  .terminal-line.cmd::before { content: '$ '; color: var(--orange); }
  .terminal-line.out { color: var(--green); }
  .terminal-line.out.success { color: #4ade80; }
  .terminal-line.hint { color: var(--muted); font-size: .74rem; opacity: .9; }
  .terminal-line.hint::before { content: '› '; color: var(--primary); }
  .cursor { font-family: var(--fm); font-size: .83rem; color: var(--orange); animation: blink 1s step-end infinite; display: inline-block; }
  .cursor.hidden { display: none; }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }
  .term-progress { height: 2px; background: rgba(255,255,255,.06); overflow: hidden; }
  .term-progress-bar { height: 100%; width: 0; background: linear-gradient(90deg, var(--green), var(--primary)); transition: width 1.2s ease; }
  .term-progress-bar.fill { width: 88%; }
  .term-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    font-family: var(--fm);
    font-size: .72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 5px 12px;
    background: var(--surface);
    box-shadow: var(--sh-sm);
  }
  .term-label-ver {
    margin-left: 8px;
    background: var(--green);
    color: #000;
    padding: 2px 6px;
    font-size: .62rem;
    border: 1px solid rgba(255,255,255,.35);
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-right { display: block; margin-top: 40px; }
    .terminal { max-width: 100%; }
  }
  @media (max-width: 540px) {
    .hero { min-height: 100dvh; padding: 0 16px; }
    .hero-inner { padding-top: 70px; padding-bottom: 32px; }
    .hero-title { font-size: clamp(2rem, 9vw, 3rem); }
    .hero-sub { font-size: .92rem; }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn-dl, .hero-actions .btn-secondary { width: 100%; justify-content: center; text-align: center; }
    .hero-badge { font-size: .65rem; padding: 4px 10px; }
  }
  @media (max-width: 400px) {
    .hero { min-height: 100dvh; padding: 0 12px; }
    .hero-inner { padding-top: 70px; padding-bottom: 30px; }
    .hero-title { font-size: clamp(1.7rem, 10vw, 2.2rem); }
    .hero-sub { font-size: .85rem; margin-bottom: 28px; }
  }
</style>

<script>
  (function () {
    const termBox = document.getElementById('terminal-box');
    const t1 = document.getElementById('t1');
    const t2 = document.getElementById('t2');
    const t3 = document.getElementById('t3');
    const t4 = document.getElementById('t4');
    const cursor = document.getElementById('tcursor');
    const copyBtn = document.getElementById('term-copy');
    const progressBar = document.getElementById('term-progress-bar');
    const tabs = document.querySelectorAll('.term-tab');
    if (!termBox || !t1 || !t2 || !t3) return;

    const tabPresets = {
      aur: {
        cmd: 'yay -S beamsync-bin',
        out1: ':: Resolving dependencies...',
        out2: '\u2713 BeamSync v2.5.0 — ready. Run: beamsync',
        hint: 'hint: phone needs no app — just scan QR',
        label: 'AUR'
      },
      binary: {
        cmd: 'curl -LO beamsync.AppImage && chmod +x *.AppImage',
        out1: '  → 14.2 MB downloaded @ 4.8 MB/s',
        out2: '\u2713 BeamSync ready — double-click to launch',
        hint: 'hint: also on Arch AUR: beamsync-bin',
        label: 'Binary'
      },
      source: {
        cmd: 'git clone beamsync && wails build',
        out1: '  → Go 1.25 + Svelte + Wails v2 building...',
        out2: '\u2713 built → desktop/build/bin/BeamSync',
        hint: 'hint: Go 1.25+ & Node required',
        label: 'Source'
      },
    };
    let activeTab = 'aur';
    let currentCmd = tabPresets.aur.cmd;
    let timerIds = [];
    let running = false;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function clearTimers() { timerIds.forEach(id => clearTimeout(id)); timerIds = []; }
    function setTimer(fn, ms) { const id = setTimeout(fn, ms); timerIds.push(id); return id; }

    function typeText(el, text, speed) {
      return new Promise(resolve => {
        if (prefersReduced) { el.textContent = text; resolve(); return; }
        let i = 0;
        el.textContent = '';
        const tick = () => {
          el.textContent = text.slice(0, ++i);
          if (i < text.length) setTimer(tick, speed);
          else resolve();
        };
        tick();
      });
    }

    async function runCycle(preset) {
      if (running) return;
      running = true;
      const p = preset || tabPresets[activeTab];
      currentCmd = p.cmd;
      // reset
      t1.textContent = ''; t2.textContent = ''; t3.textContent = ''; if (t4) t4.textContent = '';
      t1.className = 'terminal-line cmd'; t2.className = 'terminal-line out'; t3.className = 'terminal-line out success'; if (t4) t4.className = 'terminal-line hint';
      if (cursor) cursor.classList.remove('hidden');
      if (progressBar) { progressBar.classList.remove('fill'); void progressBar.offsetWidth; }

      await typeText(t1, p.cmd, 38);
      await new Promise(r => { setTimer(r, 260); });
      await typeText(t2, p.out1, 18);
      await new Promise(r => { setTimer(r, 300); });
      if (progressBar) progressBar.classList.add('fill');
      await typeText(t3, p.out2, 18);
      await new Promise(r => { setTimer(r, 320); });
      if (t4) await typeText(t4, p.hint, 16);
      if (cursor) cursor.classList.add('hidden');

      setTimer(() => {
        if (cursor) cursor.classList.remove('hidden');
        running = false;
        // loop: stay on same tab, restart after pause
        setTimer(() => runCycle(tabPresets[activeTab]), 3400);
      }, 3200);
    }

    // Tabs
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.tab;
        if (!tabPresets[key] || key === activeTab) return;
        activeTab = key;
        tabs.forEach(t => {
          const isActive = t.dataset.tab === key;
          t.classList.toggle('active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });
        clearTimers();
        running = false;
        if (progressBar) progressBar.classList.remove('fill');
        runCycle(tabPresets[key]);
        // update copy target
        currentCmd = tabPresets[key].cmd;
      });
    });

    // Copy
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(currentCmd);
          const orig = copyBtn.innerHTML;
          copyBtn.classList.add('copied');
          copyBtn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg><span>Copied</span>';
          setTimer(() => { copyBtn.innerHTML = orig; copyBtn.classList.remove('copied'); }, 1800);
        } catch {
          // fallback: select t1
          const range = document.createRange();
          range.selectNodeContents(t1);
          const sel = window.getSelection();
          sel.removeAllRanges(); sel.addRange(range);
        }
      });
    }

    // Start: static fallback is already visible for no-JS / reduced-motion.
    // Enhance with animation when in view.
    if (prefersReduced) return; // leave static content, no animation nor clearing

    // Prepare for animation: clear static text briefly after observation, then type
    const observer = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        observer.disconnect();
        // small delay so user sees static then typing starts
        setTimer(() => runCycle(tabPresets[activeTab]), 400);
      }
    }, { threshold: 0.3 });
    observer.observe(termBox);

    window.addEventListener('beforeunload', () => { clearTimers(); try { observer.disconnect(); } catch {} });
  })();
</script>
