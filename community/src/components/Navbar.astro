      transition: max-height 0.35s cubic-bezier(.4,0,.2,1), opacity 0.25s ease, transform 0.3s ease;
    }
    .nav-links.open {
      max-height: calc(100dvh - 56px);
      max-height: calc(100vh - 56px);
