# ============================================
# BeamSync .gitignore
# ============================================

# ----- Build Artifacts -----
desktop/build/bin/
desktop/desktop
desktop/desktop.exe

# ----- Go Workspace (auto-generated) -----
go.work
go.work.sum

# ----- Android SDK Outputs -----
*.aar
*-sources.jar

# ----- Node / Frontend -----
desktop/frontend/node_modules/
desktop/frontend/dist/
desktop/frontend/.svelte-kit/
desktop/frontend/.vercel/
desktop/frontend/.output/

# ----- Wails Auto-generated -----
desktop/wailsjs/

# ----- Packaging: Debian -----
build/linux/deb_pkg/
build/linux/*.deb

# ----- Packaging: AppImage -----
desktop/AppDir/
*.AppImage
desktop/appimagetool-*.AppImage

# ----- Packaging: Arch Linux -----
PKGBUILD_aur_temp
*.pkg.tar.zst
desktop/packaging/arch/pkg/
desktop/packaging/arch/src/
desktop/packaging/arch/BeamSync

# ----- IDE / Editor -----
.vscode/
.idea/
*.swp
*~
*.swo

# ----- System Files -----
.DS_Store
Thumbs.db
desktop/Thumbs.db
ehthumbs.db

# ----- Logs -----
*.log

# ----- Agent / AI Tooling -----
.agent/
.kilo/
.gemini/

# ----- Graphify (local analysis cache) -----
graphify-out/

# ----- Scratch / Temp Files -----
reply.md
rewrite_app.py